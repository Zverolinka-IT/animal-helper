{
  "name": "animal-helper",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source infrastructure for reporting and coordinating help for animals in Slovakia.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "node scripts/require-node.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:destroy": "node scripts/local-db.mjs destroy",
    "db:down": "node scripts/local-db.mjs down",
    "db:init": "node scripts/local-db.mjs init",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:status": "node scripts/local-db.mjs status",
    "db:up": "node scripts/local-db.mjs up",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:status": "node scripts/local-db.mjs status",
    "dev:stop": "node scripts/local-db.mjs down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --recursive --if-present test && node --test scripts/*.test.mjs",
    "test:integration": "pnpm --filter @animal-helper/event-store test:integration",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prettier/plugin-pug": "3.6.0",
    "@types/node": "24.19.2",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vue-pug": "1.0.0-alpha.6",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
