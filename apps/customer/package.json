{
  "name": "@animal-helper/customer",
  "version": "0.0.0",
  "private": true,
  "description": "Fresh customer frontend for Animal Helper.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --cache",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --check --ignore-unknown . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write --ignore-unknown . --ignore-path ../../.prettierignore",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@animal-helper/client": "workspace:*",
    "@floating-ui/vue": "2.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@vueuse/core": "14.3.0",
    "overlayscrollbars": "2.13.0",
    "overlayscrollbars-vue": "0.5.9",
    "vue": "3.5.43",
    "vue-router": "5.2.0",
    "@animal-helper/guidance": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/language-plugin-pug": "3.3.11",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "pug": "3.0.4",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "vite-plugin-svg-icons-ng": "1.9.3",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
